struct url_parts{
    std::string scheme;
    std::string host;
    std::string port;
    std::string path;
};




inline url_parts parse_url(std::string_view url_str) {
    url_parts ret{};

    auto scheme_end = url_str.find("://");
    if (scheme_end == std::string_view::npos)
        throw std::runtime_error("Invalid URL");

    ret.scheme = url_str.substr(0, scheme_end);
    url_str.remove_prefix(scheme_end + 3);

    auto colon = url_str.find(':');
    auto slash = url_str.find('/');

    if (colon == std::string_view::npos) {
        // host[/path]

        if (slash == std::string_view::npos) {
            ret.host = url_str;
        } else {
            ret.host = url_str.substr(0, slash);
            ret.path = url_str.substr(slash);
        }

        return ret;
    }

    // host:...

    ret.host = url_str.substr(0, colon);
    url_str.remove_prefix(colon + 1);

    slash = url_str.find('/');

    if (slash == std::string_view::npos) {
        // host:port

        ret.port = url_str;
        return ret;
    }

    // host:port/path

    ret.port = url_str.substr(0, slash);
    ret.path = url_str.substr(slash);

    return ret;
}








inline std::string generate_binary_peer_id() {
    std::vector<uint8_t> peer_id(20);
    
    std::random_device rd;
    // Using independent_bits_engine to cleanly feed a full byte of randomness at a time
    std::independent_bits_engine<std::mt19937, 8, unsigned char> bit_eng(rd());
    
    for (size_t i = 0; i < 20; ++i) {
        peer_id[i] = bit_eng();
    }
    
    return std::string(peer_id.begin(),peer_id.end());
}










